# DocuMind settings - this file is read directly by the app. Never commit it.
GROQ_API_KEY=paste_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings run locally (Groq has no embeddings API).
# fastembed = best quality, downloads a ~130 MB model on first run
# hash      = tiny offline fallback with no download
EMBED_BACKEND=fastembed
